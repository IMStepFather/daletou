# Server酱 SENDKEY（https://sct.ftqq.com 微信扫码获取）
# 部署后复制本文件为 .env 并填入你的 key；.env 含敏感凭证，勿提交版本库
SERVERCHAN_SENDKEY=

# Cloudflare Pages 报表同步（可选；留空则 sync_pages.sh 自动跳过，不影响主流程）
# API Token 权限：Account -> Cloudflare Pages -> Edit，作用域仅选本账户
# Account ID：Cloudflare 控制台右侧栏，32 位十六进制串
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
PAGES_PROJECT=daletou
PAGES_DOMAIN=daletou.680868.xyz
# 可选：wrangler 可执行文件路径；留空则依次查找 wrangler、npx
WRANGLER_BIN=
