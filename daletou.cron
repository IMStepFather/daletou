# daletou cron jobs (ASCII only, LF line endings required).
# IMPORTANT: install by APPENDING. Never run "crontab daletou.cron",
# it would erase existing jobs (e.g. Tencent Cloud stargate monitor).
# Filter the whole old daletou block (including sync_pages.sh) to avoid duplicates.
#   ( crontab -l 2>/dev/null | sed 's/\r$//' \
#       | grep -v -e 'daletou' -e '^CRON_TZ=' -e '^SHELL=' -e '^PATH=' -e '^#'; \
#     cat /opt/daletou/daletou.cron ) | crontab -
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
CRON_TZ=Asia/Shanghai

# Every day 09:00: idempotent self-heal. Ensures the upcoming draw always
# has a prediction row even if a scheduled run was missed. No-op when the
# record exists (append_ticket rejects duplicate dates).
0 9 * * * /opt/daletou/run.sh generate >> /opt/daletou/logs/cron.log 2>&1
# Mon/Wed/Sat 21:35 / 22:30 / 23:30 fetch (retry if data not published yet).
# All runs are idempotent: already-filled records are never re-fetched or re-notified.
35 21 * * 1,3,6 /opt/daletou/run.sh fetch >> /opt/daletou/logs/cron.log 2>&1
30 22 * * 1,3,6 /opt/daletou/run.sh fetch >> /opt/daletou/logs/cron.log 2>&1
30 23 * * 1,3,6 /opt/daletou/run.sh fetch >> /opt/daletou/logs/cron.log 2>&1
# Every 5 minutes: publish results.html to Cloudflare Pages (idempotent, silent when unchanged).
*/5 * * * * /opt/daletou/sync_pages.sh >> /opt/daletou/logs/cron.log 2>&1
